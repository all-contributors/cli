{
  "name": "all-contributors-cli",
  "version": "7.0.0",
  "description": "Tool to easily add recognition for new contributors",
  "keywords": [
    "all-contributors",
    "contributors"
  ],
  "homepage": "https://github.com/all-contributors/all-contributors-cli#readme",
  "bugs": {
    "url": "https://github.com/all-contributors/all-contributors-cli/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/all-contributors/cli.git"
  },
  "license": "MIT",
  "author": "Jeroen Engels <jfm.engels@gmail.com>",
  "sideEffects": false,
  "type": "module",
  "main": "dist/api.js",
  "bin": {
    "all-contributors": "dist/cli.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "add-contributor": "node src/cli.js add",
    "build": "cp -r src dist",
    "commit": "git-cz",
    "dev": "./src/cli.js",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "knip": "knip",
    "lint": "eslint .",
    "prepare": "husky",
    "start": "./dist/cli.js",
    "test": "vitest",
    "test:coverage": "vitest --coverage"
  },
  "lint-staged": {
    "*.js": [
      "eslint --fix",
      "prettier --write"
    ],
    "!(*.js)": "prettier --ignore-unknown --write"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  },
  "dependencies": {
    "eta": "^4.5.1",
    "inquirer": "^14.0.2",
    "json-fixer": "^1.6.8",
    "yargs": "^18.0.0",
    "yoctocolors": "^2.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@eslint/markdown": "^8.0.3",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsonc": "^3.4.2",
    "eslint-plugin-package-json": "^1.14.0",
    "eslint-plugin-vitest": "^0.5.4",
    "eslint-plugin-yml": "^3.10.0",
    "git-cz": "^4.7.6",
    "globals": "^17.1.0",
    "husky": "^9.1.0",
    "knip": "^6.10.0",
    "lint-staged": "^17.0.8",
    "nock": "^15.0.5",
    "prettier": "^3.8.1",
    "vitest": "^5.1.0"
  },
  "optionalDependencies": {
    "prettier": "^3"
  },
  "engines": {
    "node": ">=22.22.0"
  }
}
